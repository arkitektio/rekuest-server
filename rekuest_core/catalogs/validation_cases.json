{
  "description": "Blok validation cases both server implementations must agree on: rekuest's facade/catalog_validation.py and takt's crates/facade/src/catalog_validation.rs. Each case is a component tree validated against base plus `catalogs` (stored-JSON form, snake_case) in `context` (default HTML), with `demo_state`, as an action's own blok when `action` is true (default false). `expect.refused` is a substring of the refusal, or null when the blok is stored; `expect.diagnostics` are the finding codes, in order.",
  "cases": [
    {
      "name": "a conforming blok has no findings",
      "catalogs": [
        {
          "name": "electron",
          "components": [
            {
              "name": "Slider",
              "props": [
                {
                  "key": "value",
                  "kind": "FLOAT",
                  "required": true
                },
                {
                  "key": "onChange",
                  "kind": "CALLBACK"
                }
              ],
              "accepts_children": false
            },
            {
              "name": "Box"
            }
          ],
          "operations": [
            {
              "name": "fmt",
              "arguments": [
                {
                  "key": "v",
                  "kind": "ANY"
                }
              ],
              "returns": "STRING"
            }
          ]
        }
      ],
      "components": [
        {
          "id": "root",
          "component": "Box",
          "children": [
            {
              "id": "s",
              "component": "Slider",
              "props": [
                {
                  "key": "value",
                  "static_value": 1
                }
              ]
            }
          ]
        }
      ],
      "expect": {
        "refused": null,
        "diagnostics": []
      }
    },
