  "source": "<Scene>\n  <Model id=\"scope\" src=\"@self.assets.scope\">\n    <Move\n      node=\"stage_x\"\n      axis=\"x\"\n      value=\"@self.Stage.x\"\n      animateTo=\"@self.Stage.target_x\"\n      speed=\"@self.Stage.speed\"\n    />\n    <Show node=\"incubator\" when=\"@self.Stage.mounted\" />\n    <OnClick node=\"turret\" open=\"turret_panel\" />\n    <Popout node=\"laser_out\" trigger=\"hover\">\n      <Card>\n        <CardContent>\n          <Badge text=\"Laser\" />\n        </CardContent>\n      </Card>\n    </Popout>\n  </Model>\n  <Robot\n    id=\"arm\"\n    src=\"@self.assets.arm\"\n    origin=\"0.6 0 0\"\n    onJointChange=\"@self.move_joint(name=event.name, position=event.value)\"\n  >\n    <Glow node=\"tool0\" on=\"@self.Stage.mounted\" />\n    <Attach node=\"sample\" to=\"scope:stage_x\" when=\"@self.Stage.mounted\" />\n  </Robot>\n</Scene>",
  "tree": {
